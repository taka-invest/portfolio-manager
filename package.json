{
  "name": "portfolio-manager",
  "version": "2.6.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "build:firebase": "node scripts/build-firebase.mjs",
    "verify:firebase": "npm run build:firebase && node --test tests/firebase-foundation.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-finance-base \"node --test tests/emulator/*.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.1",
    "firebase": "13.4.0",
    "firebase-tools": "15.37.0"
  }
}
