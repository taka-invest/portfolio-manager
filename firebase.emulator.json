{
  "hosting": {
    "public": "dist/firebase",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
          }
        ]
      },
      {
        "regex": "^/(portfolio_manager\\.html)?$",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://finnhub.io https://www.live-rates.com https://api.exchangerate.fun https://api.frankfurter.dev https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://apis.google.com; frame-src 'self' https://finance-base-edcc7.firebaseapp.com https://accounts.google.com https://apis.google.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"
          }
        ]
      },
      {
        "source": "/research/*.html",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com; frame-src 'self' https://finance-base-edcc7.firebaseapp.com; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(css|mjs)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/financials",
        "function": {
          "functionId": "financialsApi",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/api/analyze",
        "function": {
          "functionId": "analyzeApi",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/api/screener",
        "function": {
          "functionId": "screenerApi",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/api/chart",
        "function": {
          "functionId": "chartApi",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/api/market",
        "function": {
          "functionId": "marketApi",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/",
        "destination": "/portfolio_manager.html"
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-northeast1",
    "rules": "firestore.rules"
  },
  "emulators": {
    "hosting": {
      "port": 5100
    },
    "firestore": {
      "port": 8180,
      "websocketPort": 9250
    },
    "auth": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    },
    "functions": {
      "port": 5101
    },
    "hub": {
      "port": 4410
    },
    "logging": {
      "port": 4510
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "finance-api",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log"
      ]
    }
  ]
}
