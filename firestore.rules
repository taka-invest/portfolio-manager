rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in Google account may read and write only its OWN workspace.
    // Neither public reads nor cross-user reads are allowed.
    match /users/{userId}/workspaces/{docId} {
      allow read: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && docId == 'portfolio';
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && docId == 'portfolio'
        && request.resource.data.keys().hasOnly(['payload', 'revision', 'updatedAt'])
        && request.resource.data.payload is map
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.payload.version == 3
        && request.resource.data.payload.keys().size() <= 20
        && request.resource.data.payload.positions is list
        && request.resource.data.payload.positions.size() <= 10000
        && (
          !exists(/databases/$(database)/documents/users/$(userId)/workspaces/$(docId))
          || request.resource.data.revision == resource.data.revision + 1
        );
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
